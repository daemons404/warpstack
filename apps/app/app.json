{
  "expo": {
    "name": "Warpstack",
    "slug": "warpstack",
    "scheme": "warpstack",
    "version": "0.1.0",
    "icon": "./assets/icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "plugins": [
      "expo-router",
      ["expo-image-picker", { "photosPermission": "Choose photos to post.", "cameraPermission": false, "microphonePermission": false }]
    ],
    "experiments": { "typedRoutes": false },
    "web": { "bundler": "metro", "output": "single", "favicon": "./assets/favicon.png" },
    "ios": { "bundleIdentifier": "xyz.warpstack.app" },
    "android": { "package": "xyz.warpstack.app" }
  }
}
