{
  "name": "@warpstack/app",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "main": "expo-router/entry",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.worker.json",
    "start": "expo start",
    "web": "expo start --web",
    "ios": "warpstack-vault-build && expo run:ios --device",
    "ios:release": "warpstack-vault-build && expo run:ios --device --configuration Release",
    "build:web": "expo export -p web --output-dir dist && node scripts/web-headers.mjs",
    "dev": "expo export -p web --output-dir dist && node scripts/web-headers.mjs && node scripts/offline-config.mjs && wrangler d1 migrations apply DB --local -c wrangler.offline.jsonc && wrangler dev --local -c wrangler.offline.jsonc",
    "deploy": "node scripts/deploy.mjs",
    "dev:remote": "expo export -p web --output-dir dist && node scripts/web-headers.mjs && wrangler d1 migrations apply DB --local && wrangler dev"
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.14",
    "@tanstack/react-query": "catalog:",
    "@warpstack/api": "workspace:*",
    "@warpstack/app-core": "workspace:*",
    "@warpstack/client": "workspace:*",
    "@warpstack/ui": "workspace:*",
    "@warpstack/wallet": "workspace:*",
    "expo": "catalog:",
    "expo-constants": "~58.0.12",
    "expo-file-system": "catalog:",
    "expo-image": "catalog:",
    "expo-image-manipulator": "catalog:",
    "expo-image-picker": "catalog:",
    "expo-video": "catalog:",
    "expo-linking": "~58.0.13",
    "expo-router": "catalog:",
    "expo-secure-store": "catalog:",
    "expo-status-bar": "~58.0.3",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-native": "catalog:",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "catalog:",
    "react-native-web": "~0.21.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@types/react": "catalog:",
    "wrangler": "catalog:"
  }
}
