# OS and editor junk
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# Python
__pycache__/
*.pyc
.venv/

# Node (for when packages land)
node_modules/
dist/
.turbo/
*.tsbuildinfo
.env
.env.*
!.env.example

# Explainer videos: build outputs, all regenerable with videos/tools/build.sh.
# Kept: script.json, scene.py, audio/raw/*.mp3 (the paid narration), audio/*.json,
# wslib/, tools/, fonts/, index.html and out/posters/.
videos/*/media/
videos/*/frames/
videos/*/qa/
videos/*/preview.mp4
videos/*/render-*.log
videos/*/audio/seg/
videos/*/audio/seg_orig/
videos/*/audio/narration.wav

# Final renders (~250 MB). Remove this line to commit them, or track them with Git LFS.
videos/out/*.mp4

# Amp orb portals
.amp/portals/*

# Wrangler local secrets and state
.dev.vars
.wrangler/

# Generated by apps/app/scripts/offline-config.mjs.
wrangler.offline.jsonc
# Generated by apps/app/scripts/deploy.mjs: wrangler.jsonc plus the account's database ID.
wrangler.deploy.jsonc
# The previous name of that file.
wrangler.nomedia.jsonc

# Private strings the leak scan looks for (scripts/scan-leaks.sh); never published.
.leak-patterns.local

# Built by packages/create-warpstack-app/scripts/build-template.mjs from apps/app.
packages/create-warpstack-app/template/
