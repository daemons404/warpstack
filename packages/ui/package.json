{
  "name": "@warpstack/ui",
  "version": "0.1.1",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/daemons404/warpstack.git",
    "directory": "packages/ui"
  },
  "homepage": "https://github.com/daemons404/warpstack#readme",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@warpstack/app-core": "workspace:*",
    "@warpstack/client": "workspace:*",
    "@warpstack/contract": "workspace:*",
    "@warpstack/protocol": "workspace:*"
  },
  "peerDependencies": {
    "expo-image": "^58.0.0",
    "expo-router": "^58.0.0",
    "expo-video": "^58.0.0",
    "react": "^19.1.0",
    "react-native": "~0.88.0",
    "react-native-svg": "^15.16.0"
  },
  "devDependencies": {
    "@tanstack/react-query": "catalog:",
    "@types/react": "catalog:",
    "expo-image": "catalog:",
    "expo-router": "catalog:",
    "expo-video": "catalog:",
    "react": "catalog:",
    "react-native": "catalog:",
    "react-native-svg": "catalog:"
  },
  "description": "Warpstack's default screens and slots in React Native, for the phone and the web."
}
